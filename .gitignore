# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Build output ─────────────────────────────────────────────
# NOTE: these are intentionally unanchored so they match the nested
# workspaces too (crates/nabu-ui, crates/nabu-core, src-tauri each
# have their own target/ and dist/).
target/
dist/
out/
generated/
*.rs.bk

# ── Test / lint artifacts ────────────────────────────────────
test-results/
playwright-report/
*.tsbuildinfo

# ── Editor / OS ──────────────────────────────────────────────
.DS_Store
*.log
.idea/
.vscode/
.kiro/
.zcode/

# ── Mise local overrides ─────────────────────────────────────
.mise.local.toml
.mise/*.env
core

# ── Nabu runtime data (vault-local files created by the app) ─
.nabu/

# ── Qodana / JetBrains inspection results (regenerated each run) ─
*.xml
*.descriptions.xml
